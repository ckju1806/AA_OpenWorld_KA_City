; Engine configuration file.
; Projekt: Fächer-City: Asphalt & Schatten
; Engine: Godot 4.7.2-stable (siehe config/toolchain.md)

config_version=5

[application]

config/name="Fächer-City: Asphalt & Schatten"
config/description="Stilisiertes Open-World-Actionspiel in einer verdichteten Karlsruher Innenstadt."
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Faecherstadt"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.07, 0.06, 0.08, 1)
config/icon="res://icon.svg"
config/windows_native_icon="res://assets/icons/faecherstadt.ico"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
Settings="*res://src/autoload/settings.gd"
GameState="*res://src/autoload/game_state.gd"
SaveManager="*res://src/autoload/save_manager.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
App="*res://src/autoload/app.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[layer_names]

3d_physics/layer_1="welt"
3d_physics/layer_2="spieler"
3d_physics/layer_3="fahrzeuge"
3d_physics/layer_4="npc"
3d_physics/layer_5="trigger"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
common/max_physics_steps_per_frame=6

[rendering]

rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.2, 0.18, 0.22, 1)
occlusion_culling/use_occlusion_culling=false
